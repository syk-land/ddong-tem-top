rules_version = '2';

// ============================================================
// Firestore 보안 규칙
//   users/{uid}        — 본인만 자기 프로필 read/write
//   meta/{uid}         — 본인만 자기 진행도 read/write
//   leaderboard/{uid}  — 본인만 자기 doc write, 모든 로그인 사용자 read
//
// 배포: Firebase 콘솔 → Firestore Database → 규칙 탭 에
//       이 파일 내용을 그대로 복사 → 게시.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 사용자 프로필
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // 게임 진행도 (개인 데이터)
    match /meta/{uid} {
      allow read, write: if isOwner(uid);
    }

    // 리더보드 — 본인 doc 만 작성, 모두 읽기
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid)
        // 필드 화이트리스트 (악의적 필드 추가 방지)
        && request.resource.data.keys().hasOnly([
             'uid', 'nickname', 'bestScore', 'bestRank', 'clearCount', 'updatedAt'
           ])
        // bestScore 는 숫자
        && request.resource.data.bestScore is number;
    }
  }
}
