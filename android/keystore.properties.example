# 이 파일을 keystore.properties 로 복사하고 실제 값으로 채워라 (.gitignore 처리됨).
#
# 1) 키스토어 생성 (Windows PowerShell / cmd, JDK 설치 후):
#    cd D:\workspace\climetop\android
#    mkdir keystore
#    keytool -genkey -v -keystore keystore\release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias climetop
#
#    (CN/OU 등 묻는 항목은 적당히 채우고, 비밀번호 2개 반드시 메모.
#     이 jks 파일을 절대 잃지 마라. 잃으면 같은 패키지명으로 덮어쓰기 영영 불가.)
#
# 2) 이 파일을 keystore.properties 로 복사하고 아래 값 채워라:
KEYSTORE_FILE=keystore/release.jks
KEYSTORE_PASSWORD=changeme
KEY_ALIAS=climetop
KEY_PASSWORD=changeme

# 매 릴리스마다 VERSION_CODE 를 +1 하라. 같으면 폰이 새 빌드를 거부할 수 있다.
VERSION_CODE=1
VERSION_NAME=1.0
